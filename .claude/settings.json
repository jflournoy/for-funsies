{
  "permissions": {
    "allow": [
      "Bash(ls*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git fetch*)",
      "Bash(git branch)",
      "Bash(npm run typecheck*)",
      "Bash(npm run build*)",
      "Bash(npm run check*)",
      "Bash(npm run ledger*)",
      "Bash(npm ci --ignore-scripts*)",
      "Bash(node scripts/*)",
      "Bash(node dist/*)",
      "Bash(python3 scripts/*)",
      "WebSearch",
      "WebFetch",
      "Bash(git add *)"
    ],
    "deny": [
      "Read(secrets/**)",
      "Read(**/secrets/**)",
      "Bash(*secrets/*)"
    ],
    "additionalDirectories": [
      "/tmp"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/vexp-hint.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
