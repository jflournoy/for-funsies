# Node / TypeScript
node_modules/
dist/
build/
*.tsbuildinfo
.npm
npm-debug.log*

# Never commit these. CI installs with `npm ci --ignore-scripts`.
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
.history/
*.swp

# Per-machine agent state. Note .codex/ and .vscode/mcp.json are NOT here:
# their paths are container-internal, so they reproduce in a volume clone.
.claude/
*.vexp-bak

# Resolved by the devcontainer CLI at build time; not pinned on purpose
.devcontainer/devcontainer-lock.json

# Python (tooling in scripts/ only)
__pycache__/
*.pyc
.venv/
venv/
